{
  "name": "auditlogs",
  "type": "object",
  "required": ["repositoryId", "agentName", "action", "timestamp"],
  "properties": {
    "repositoryId": {
      "bsonType": "string",
      "description": "Reference to repositories collection"
    },
    "userId": {
      "bsonType": "string",
      "description": "User ID if human action"
    },
    "agentName": {
      "bsonType": "string",
      "description": "AI agent that performed action (Analyzer, Fixer, etc.)"
    },
    "action": {
      "bsonType": "string",
      "description": "Action performed (analyze, create-pr, merge, etc.)"
    },
    "details": {
      "bsonType": "object",
      "description": "Additional action details"
    },
    "riskLevel": {
      "bsonType": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"],
      "description": "Risk level of the action"
    },
    "approvalRequired": {
      "bsonType": "bool",
      "description": "Whether human approval was required"
    },
    "approved": {
      "bsonType": "bool",
      "description": "Whether action was approved"
    },
    "timestamp": {
      "bsonType": "string",
      "title": "datetime",
      "description": "Action timestamp"
    }
  }
}
