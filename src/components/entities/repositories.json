{
  "name": "repositories",
  "type": "object",
  "required": [
    "userId",
    "repoName",
    "repoOwner",
    "repoUrl",
    "platform",
    "isActive",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "userId": {
      "bsonType": "string",
      "description": "ID of the user who connected this repository"
    },
    "repoName": {
      "bsonType": "string",
      "description": "Repository name"
    },
    "repoOwner": {
      "bsonType": "string",
      "description": "Repository owner/organization"
    },
    "repoUrl": {
      "bsonType": "string",
      "description": "Full repository URL"
    },
    "platform": {
      "bsonType": "string",
      "enum": ["github", "gitlab"],
      "description": "Git platform"
    },
    "defaultBranch": {
      "bsonType": "string",
      "description": "Default branch name (main/master)"
    },
    "language": {
      "bsonType": "string",
      "description": "Primary programming language"
    },
    "framework": {
      "bsonType": "string",
      "description": "Detected framework (React, Next.js, etc.)"
    },
    "isActive": {
      "bsonType": "bool",
      "description": "Whether AI monitoring is active"
    },
    "lastAnalyzedAt": {
      "bsonType": "string",
      "title": "datetime",
      "description": "Last analysis timestamp"
    },
    "createdAt": {
      "bsonType": "string",
      "title": "datetime",
      "description": "Repository connection timestamp"
    },
    "updatedAt": {
      "bsonType": "string",
      "title": "datetime",
      "description": "Last update timestamp"
    }
  }
}
